#!/usr/bin/env bash
export PLUGIN_COMMAND_PREFIX="libredb-studio"
# dokku exports these; the defaults are dokku's own
export DOCKER_BIN=${DOCKER_BIN:="docker"}
export DOKKU_SYSTEM_USER=${DOKKU_SYSTEM_USER:="dokku"}
export DOKKU_SYSTEM_GROUP=${DOKKU_SYSTEM_GROUP:="dokku"}
export DOKKU_LIB_HOST_ROOT=${DOKKU_LIB_HOST_ROOT:=$DOKKU_LIB_ROOT}

# Where the plugin keeps its state on the dokku host, and the same directory as
# the docker daemon sees it. The two differ only when dokku itself runs in a
# container, where bind mounts must name the host path.
export LIBREDB_STUDIO_ROOT=${LIBREDB_STUDIO_ROOT:="$DOKKU_LIB_ROOT/data/$PLUGIN_COMMAND_PREFIX"}
export LIBREDB_STUDIO_HOST_ROOT=${LIBREDB_STUDIO_HOST_ROOT:="$DOKKU_LIB_HOST_ROOT/data/$PLUGIN_COMMAND_PREFIX"}

# seed/ is mounted read-only into Studio and holds only the assembled file.
# entries/ holds one fragment per datastore service and is never mounted.
# storage/ is Studio's own sqlite store, owned by the image's user.
export LIBREDB_STUDIO_SEED_DIR="$LIBREDB_STUDIO_ROOT/seed"
export LIBREDB_STUDIO_SEED_FILE="$LIBREDB_STUDIO_SEED_DIR/connections.json"
export LIBREDB_STUDIO_ENTRIES_DIR="$LIBREDB_STUDIO_ROOT/entries"
export LIBREDB_STUDIO_STORAGE_DIR="$LIBREDB_STUDIO_ROOT/storage"
export LIBREDB_STUDIO_LOCK_FILE="$LIBREDB_STUDIO_ROOT/seed.lock"
# seconds a command waits for another one holding the lock
export LIBREDB_STUDIO_LOCK_TIMEOUT=${LIBREDB_STUDIO_LOCK_TIMEOUT:="120"}

# dokku 0.38 keeps an app's environment in $DOKKU_LIB_ROOT/config/<app>/ENV,
# beside every plugin's properties in $DOKKU_LIB_ROOT/config/<plugin>, and
# apps:destroy removes the app's directory there. Under the plugin's own name
# the properties would go with a Studio app of the same name, so they are kept
# under a name no app can have: an app name begins with a letter or a digit.
export LIBREDB_STUDIO_PROPERTIES="_libredb-studio"

export LIBREDB_STUDIO_DEFAULT_APP="libredb-studio"
export LIBREDB_STUDIO_DEFAULT_IMAGE="ghcr.io/libredb/libredb-studio:0.17.0"
export LIBREDB_STUDIO_NETWORK="libredb-studio"

# The image runs as nextjs (1001) in group nodejs (1001).
export LIBREDB_STUDIO_UID=${LIBREDB_STUDIO_UID:="1001"}
export LIBREDB_STUDIO_GID=${LIBREDB_STUDIO_GID:="1001"}
export LIBREDB_STUDIO_PORT="3000"
export LIBREDB_STUDIO_SEED_MOUNT="/run/libredb-seed"
export LIBREDB_STUDIO_DATA_MOUNT="/app/data"

# dokku datastore plugin name and the Studio connection type it maps to
export LIBREDB_STUDIO_DATASTORES="postgres:postgres mysql:mysql mariadb:mysql mongo:mongodb redis:redis"
