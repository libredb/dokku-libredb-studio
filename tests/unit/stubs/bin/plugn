#!/usr/bin/env bash
# plugn trigger service-list, answered from the services the datastore stub
# holds under $STUB_STATE/services/<type>/<service>. When
# $STUB_STATE/service-list-fails exists, it fails the way plugn does when one
# datastore's trigger exits non-zero.
set -eo pipefail
echo "plugn $*" >>"$STUB_STATE/calls.log"

[[ "$1 $2" == "trigger service-list" ]] || {
  echo "plugn stub: unsupported call: $*" >&2
  exit 2
}
if [[ -f "$STUB_STATE/service-list-fails" ]]; then
  echo "failed to list services" >&2
  exit 1
fi
shopt -s nullglob
for dir in "$STUB_STATE"/services/*/*; do
  echo "$(basename "$(dirname "$dir")"):$(basename "$dir")"
done
