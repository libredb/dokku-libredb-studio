#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config"
source "$PLUGIN_AVAILABLE_PATH/libredb-studio/internal-functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

fn-libredb-studio-random-hex() {
  declare desc="prints a random lowercase hex string of the given number of bytes"
  declare BYTES="$1"
  od -An -N"$BYTES" -tx1 /dev/urandom | tr -d ' \n'
}

cmd-libredb-studio-install() {
  declare desc="creates and deploys the Studio app and connects it to every datastore service"
  declare cmd="libredb-studio:install"
  [[ "$1" == "$cmd" ]] && shift 1

  local APP="" IMAGE="$LIBREDB_STUDIO_DEFAULT_IMAGE" ADMIN_EMAIL="" ALLOW_HTTP=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --image)
        [[ -n "$2" ]] || dokku_log_fail "--image needs a value"
        IMAGE="$2"
        shift 2
        ;;
      --admin-email)
        [[ -n "$2" ]] || dokku_log_fail "--admin-email needs a value"
        ADMIN_EMAIL="$2"
        shift 2
        ;;
      --allow-http)
        ALLOW_HTTP=true
        shift 1
        ;;
      --*)
        dokku_log_fail "Unknown flag $1"
        ;;
      *)
        [[ -z "$APP" ]] || dokku_log_fail "Only one app name may be given"
        APP="$1"
        shift 1
        ;;
    esac
  done
  APP="${APP:-$LIBREDB_STUDIO_DEFAULT_APP}"

  fn-libredb-studio-require-dirs
  local installed
  installed="$(fn-libredb-studio-app)"
  if [[ -n "$installed" ]] && fn-libredb-studio-dokku apps:exists "$installed" >/dev/null 2>&1; then
    dokku_log_fail "LibreDB Studio is already installed as app $installed"
  fi
  if fn-libredb-studio-dokku apps:exists "$APP" >/dev/null 2>&1; then
    dokku_log_fail "An app named $APP already exists. Pass another name: dokku $cmd <app>"
  fi

  # Studio keeps its accounts in the storage directory and takes the login from
  # the environment on its first start only, so every install after the first
  # signs in with the login the first one kept
  local login login_kept=false admin_password new_password
  [[ -f "$LIBREDB_STUDIO_LOGIN_FILE" ]] && login_kept=true
  new_password="$(fn-libredb-studio-random-hex 16)"
  if ! login="$(fn-libredb-studio-login "$ADMIN_EMAIL" "$new_password")"; then
    dokku_log_fail "See above. Install again without --admin-email to keep that login, or start over, which deletes Studio's saved data and accounts: sudo sh -c 'rm -rf $LIBREDB_STUDIO_STORAGE_DIR/* $LIBREDB_STUDIO_LOGIN_FILE'"
  fi
  ADMIN_EMAIL="${login%%$'\n'*}"
  admin_password="${login#*$'\n'}"

  local dokku_gid
  dokku_gid="$(getent group "$DOKKU_SYSTEM_GROUP" | cut -d: -f3)"
  [[ -n "$dokku_gid" ]] || dokku_log_fail "Could not find the id of group $DOKKU_SYSTEM_GROUP"

  fn-libredb-studio-ensure-network || dokku_log_fail "Could not create the $LIBREDB_STUDIO_NETWORK network"

  dokku_log_info1 "Creating app $APP"
  fn-libredb-studio-dokku apps:create "$APP"
  fn-libredb-studio-dokku network:set "$APP" attach-post-create "$LIBREDB_STUDIO_NETWORK"

  # Run as the image's own user with the dokku group added. Started as root, the
  # image's entrypoint drops to nextjs through gosu, which resets the
  # supplementary groups, and the seed file is readable by the dokku group only.
  fn-libredb-studio-dokku docker-options:add "$APP" deploy,run "--user $LIBREDB_STUDIO_UID:$LIBREDB_STUDIO_GID"
  fn-libredb-studio-dokku docker-options:add "$APP" deploy,run "--group-add $dokku_gid"
  fn-libredb-studio-dokku storage:mount "$APP" "$LIBREDB_STUDIO_HOST_ROOT/storage:$LIBREDB_STUDIO_DATA_MOUNT"
  fn-libredb-studio-dokku storage:mount "$APP" "$LIBREDB_STUDIO_HOST_ROOT/seed:$LIBREDB_STUDIO_SEED_MOUNT:ro"
  fn-libredb-studio-dokku ports:set "$APP" "http:80:$LIBREDB_STUDIO_PORT"

  local config=()
  config=(
    "NEXT_PUBLIC_AUTH_PROVIDER=local"
    "JWT_SECRET=$(fn-libredb-studio-random-hex 32)"
    "ADMIN_EMAIL=$ADMIN_EMAIL"
    "ADMIN_PASSWORD=$admin_password"
    "STORAGE_PROVIDER=sqlite"
    "STORAGE_SQLITE_PATH=$LIBREDB_STUDIO_DATA_MOUNT/libredb-storage.db"
    "SEED_CONFIG_PATH=$LIBREDB_STUDIO_SEED_MOUNT/connections.json"
  )
  if [[ "$ALLOW_HTTP" == "true" ]]; then
    config+=("AUTH_COOKIE_SECURE=false")
  fi
  # config:set prints every value it sets, the secrets included
  fn-libredb-studio-dokku config:set --no-restart "$APP" "${config[@]}" >/dev/null

  fn-plugin-property-write "$LIBREDB_STUDIO_PROPERTIES" "--global" "app" "$APP"
  fn-plugin-property-write "$LIBREDB_STUDIO_PROPERTIES" "--global" "image" "$IMAGE"

  dokku_log_info1 "Connecting the datastore services on this host"
  local sync_failed=false
  fn-libredb-studio-sync || sync_failed=true

  dokku_log_info1 "Deploying $IMAGE"
  fn-libredb-studio-dokku git:from-image "$APP" "$IMAGE"
  # kept only once Studio is deployed: before that it has seeded no account,
  # so a failed first install may be retried with another --admin-email
  if [[ "$login_kept" != "true" ]]; then
    fn-libredb-studio-keep-login "$ADMIN_EMAIL" "$admin_password" ||
      dokku_log_fail "Studio is deployed, but its login could not be written to $LIBREDB_STUDIO_LOGIN_FILE, so a later install would print a password Studio ignores"
  fi

  dokku_log_info1 "LibreDB Studio is running"
  dokku_log_verbose "URL:      $(fn-libredb-studio-dokku url "$APP")"
  dokku_log_verbose "Email:    $ADMIN_EMAIL"
  dokku_log_verbose "Password: $admin_password"
  if [[ "$login_kept" == "true" ]]; then
    dokku_log_verbose "This is the login of the first install, kept in $LIBREDB_STUDIO_LOGIN_FILE: Studio keeps its accounts in $LIBREDB_STUDIO_STORAGE_DIR, and a password changed in Studio since then is the one that signs in"
  else
    dokku_log_verbose "Read it again with: dokku config:get $APP ADMIN_PASSWORD. Studio stores it on its first start; change it in Studio after that"
  fi
  if [[ "$ALLOW_HTTP" != "true" ]]; then
    dokku_log_warn "The login cookie is Secure, so sign-in needs https: dokku letsencrypt:enable $APP"
    dokku_log_warn "On a trusted network only, allow plain http: dokku config:set $APP AUTH_COOKIE_SECURE=false"
  fi
  if [[ "$sync_failed" == "true" ]]; then
    dokku_log_fail "Some services could not be connected; see above, then run 'dokku $PLUGIN_COMMAND_PREFIX:sync'"
  fi
}

cmd-libredb-studio-sync() {
  declare desc="rebuilds the connection list from every datastore service on the host"
  declare cmd="libredb-studio:sync"
  [[ "$1" == "$cmd" ]] && shift 1

  fn-libredb-studio-require-dirs
  [[ -n "$(fn-libredb-studio-app)" ]] || dokku_log_fail "LibreDB Studio is not installed. Run 'dokku $PLUGIN_COMMAND_PREFIX:install'"

  dokku_log_info1 "Connecting the datastore services on this host"
  fn-libredb-studio-sync || dokku_log_fail "Some services could not be connected; see above"
  dokku_log_verbose "Studio reads the new list within SEED_CACHE_TTL_MS (60 seconds by default)"
}

cmd-libredb-studio-info() {
  declare desc="shows the Studio app, its network and the connections it is given"
  declare cmd="libredb-studio:info"
  [[ "$1" == "$cmd" ]] && shift 1

  local app
  app="$(fn-libredb-studio-app)"
  dokku_log_info2_quiet "LibreDB Studio information"
  dokku_log_verbose "$(printf "%-20s %s" "App:" "${app:-not installed}")"
  dokku_log_verbose "$(printf "%-20s %s" "Image:" "$(fn-plugin-property-get "$LIBREDB_STUDIO_PROPERTIES" "--global" "image" "")")"
  dokku_log_verbose "$(printf "%-20s %s" "Network:" "$LIBREDB_STUDIO_NETWORK")"
  dokku_log_verbose "$(printf "%-20s %s" "Seed file:" "$LIBREDB_STUDIO_SEED_FILE")"

  if [[ ! -f "$LIBREDB_STUDIO_SEED_FILE" ]]; then
    dokku_log_verbose "$(printf "%-20s %s" "Connections:" "none")"
    return 0
  fi
  dokku_log_info2_quiet "Connections (credentials are not shown)"
  # every field but the credentials
  jq -r '.connections[] | [.id, .type, "\(.host):\(.port)", (.database // "-")] | @tsv' "$LIBREDB_STUDIO_SEED_FILE" |
    column -t -s $'\t' | sed 's/^/       /'
}

cmd-libredb-studio-uninstall() {
  declare desc="detaches every datastore service from Studio and removes the connection list"
  declare cmd="libredb-studio:uninstall"
  [[ "$1" == "$cmd" ]] && shift 1

  local app
  app="$(fn-libredb-studio-app)"
  # every service lets go of the network before anything else changes
  fn-libredb-studio-detach-all ||
    dokku_log_fail "Not every service could be detached; see above. Run this again once that is fixed"

  fn-plugin-property-delete "$LIBREDB_STUDIO_PROPERTIES" "--global" "app"
  fn-plugin-property-delete "$LIBREDB_STUDIO_PROPERTIES" "--global" "image"
  dokku_log_info1 "LibreDB Studio no longer receives connections"

  if [[ -n "$app" ]] && fn-libredb-studio-dokku apps:exists "$app" >/dev/null 2>&1; then
    # the app is still attached to the network, so the network stays with it;
    # no service names it any more, so removing it later is safe
    dokku_log_verbose "The app, its data and the $LIBREDB_STUDIO_NETWORK network are kept. Remove them with:"
    dokku_log_verbose "  dokku apps:destroy $app"
    dokku_log_verbose "  dokku --force network:destroy $LIBREDB_STUDIO_NETWORK"
    dokku_log_verbose "  sudo rm -rf $LIBREDB_STUDIO_STORAGE_DIR/*"
  else
    fn-libredb-studio-remove-network || dokku_log_fail "Could not remove the $LIBREDB_STUDIO_NETWORK network"
  fi
}
